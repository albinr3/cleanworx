# Database created in Hostinger hPanel. Run database/square-booking-ga4.sql first.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cleanworx
MYSQL_USER=cleanworx_user
MYSQL_PASSWORD=replace-with-a-strong-password

# Square production application. Seller-level access is required to cover online
# bookings and appointments created by the team.
SQUARE_ACCESS_TOKEN=replace-with-square-production-token
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-with-square-webhook-signature-key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://www.cleanworxnj.com/api/square/webhooks/bookings
SQUARE_API_BASE_URL=https://connect.squareup.com
SQUARE_API_VERSION=2026-09-16

# GA4 Measurement Protocol. GA4_SERVER_CLIENT_ID is a stable technical value in
# the form two positive integers separated by a period; it must not be a customer ID.
GA4_MEASUREMENT_ID=G-FRVB9W1H8D
GA4_MEASUREMENT_PROTOCOL_API_SECRET=replace-with-ga4-measurement-protocol-secret
GA4_SERVER_CLIENT_ID=1234567890.1234567890

# Protects the scheduled reconciliation endpoint. Generate a unique long random value.
BOOKING_RECONCILIATION_CRON_SECRET=replace-with-a-long-random-secret
