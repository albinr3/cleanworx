Options -MultiViews
RewriteEngine On

# Preserve the redirects previously handled by the Next.js server.
RewriteRule ^services/?$ / [R=301,L]
RewriteRule ^addons/?$ /add-ons [R=301,L]
RewriteRule ^booking/?$ https://cleanworx-llc.square.site/ [R=302,L]
RewriteRule ^sitemap/?$ /sitemap.xml [R=301,L]

# Next.js exports /about as about.html; keep extensionless URLs working.
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html
